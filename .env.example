# The agent uses a generic OpenAI-compatible client: point these three variables at any
# OpenAI-compatible provider and the agent works unchanged. Copy to .env and fill in your key.
#
# Model ids change, and each provider names them differently. If a run fails with a model or 404
# error, GET {LLM_BASE_URL}/models with your key lists exactly what that key can use — for example:
#   curl -H "Authorization: Bearer $LLM_API_KEY" "$LLM_BASE_URL/models"
# LLM_BASE_URL must NOT end in a slash: the client appends /chat/completions to it.

# Google Gemini (OpenAI-compatible endpoint) — default; these exact values produced the
# committed generated-app/. Gemini requires the "models/" prefix on the OpenAI-compatible route.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-key-here
LLM_MODEL=models/gemini-3.6-flash

# OpenRouter — model ids are namespaced by vendor, with no "models/" prefix
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-2.5-flash

# OpenAI — bare model ids, no prefix
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
