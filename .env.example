# The agent uses a generic OpenAI-compatible client: point these three variables at any
# OpenAI-compatible provider and the agent works unchanged. Copy to .env and fill in your key.

# Google Gemini (OpenAI-compatible endpoint) — default
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-2.5-flash

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-2.5-flash

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
